# Copy to .env on the server and fill in real values. Never commit .env.
#   cp .env.example .env && nano .env

FLASK_ENV=production

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the bundled Postgres container. DATABASE_URL must use the same
# password; the host is the compose service name "db".
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://softstudio:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/softstudio

SITE_NAME=Jaybalo Studio
SITE_URL=https://jaybalostudio.com
ADMIN_EMAIL=

# OAuth (optional; leave blank to hide the provider button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Outgoing mail (password resets, email verification, contact form)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@jaybalostudio.com

# Payments
PAYMENT_PROVIDER=flutterwave
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=
DEFAULT_CURRENCY=NGN

RATELIMIT_STORAGE_URI=memory://
